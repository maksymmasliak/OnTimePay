# Host port docker-compose exposes nginx on (http://localhost:APP_PORT)
APP_PORT=8080

# PostgreSQL — container name is fixed to "postgres" on the internal Docker
# network, these values are only for the container's own setup and for the
# host-side port mapping below.
DB_NAME=ontimepay
DB_USER=ontimepay
DB_PASSWORD=secret
DB_PORT=5433

# Redis — host port mapping only (container name "redis" is fixed internally)
REDIS_PORT=6380